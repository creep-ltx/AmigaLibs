@node JsonNewNumber "json.library/JsonNewNumber"
@toc reference
@next JsonNewObject
@prev JsonNewNull

@{b}json.library/JsonNewNumber@{ub}

   @{b}NAME@{ub}
        JsonNewNumber -- A new number from its text (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonNewNumber(doc, text)
        D0                   A0   A1

        JsonNode *JsonNewNumber(JsonDoc *, CONST_STRPTR);

   @{b}FUNCTION@{ub}
        Makes a number written as text, kept exactly: "3.14", "-2e-3". For
        decimals without floating point.

   @{b}INPUTS@{ub}
        doc  - the document
        text - a JSON number

   @{b}RESULT@{ub}
        node - the number, or NULL (out of memory, or text is not a JSON
               number: "3.", "01", "+1", "1,5" are not)

   @{b}SEE ALSO@{ub}
        JsonNewInt](#jsonnewint)
@endnode

@node JsonNewObject "json.library/JsonNewObject"
@toc reference
@next JsonNewString
@prev JsonNewNumber

@{b}json.library/JsonNewObject@{ub}

   @{b}NAME@{ub}
        JsonNewObject -- A new, empty object (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonNewObject(doc)
        D0                   A0

        JsonNode *JsonNewObject(JsonDoc *);

   @{b}FUNCTION@{ub}
        Makes an empty object in doc, not yet in the tree.

   @{b}INPUTS@{ub}
        doc - the document

   @{b}RESULT@{ub}
        node - the object, or NULL (out of memory)

   @{b}SEE ALSO@{ub}
        JsonAdd](#jsonadd)
@endnode

@node JsonNewString "json.library/JsonNewString"
@toc reference
@next JsonNext
@prev JsonNewObject

@{b}json.library/JsonNewString@{ub}

   @{b}NAME@{ub}
        JsonNewString -- A new string (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonNewString(doc, text, len, flags)
        D0                   A0   A1    D0   D1

        JsonNode *JsonNewString(JsonDoc *, CONST_STRPTR, LONG, ULONG);

   @{b}FUNCTION@{ub}
        Makes a string, copying the text.

   @{b}INPUTS@{ub}
        doc   - the document
        text  - the text
        len   - its length in bytes, or -1 for up to its 0
        flags - JSF_LATIN1: the text is Amiga text. Without it the text is
                UTF-8, and a byte that is not UTF-8 is still taken as Latin-1

   @{b}RESULT@{ub}
        node - the string, or NULL

   @{b}SEE ALSO@{ub}
        JsonLatin1](#jsonlatin1), @{"JsonAdd" link "JsonAdd"}
@endnode

@node JsonNext "json.library/JsonNext"
@toc reference
@next JsonNumText
@prev JsonNewString

@{b}json.library/JsonNext@{ub}

   @{b}NAME@{ub}
        JsonNext -- The next member (0.1).

   @{b}SYNOPSIS@{ub}
        member = JsonNext(node)
        D0                A0

        JsonNode *JsonNext(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns the member after node in its object or array.

   @{b}INPUTS@{ub}
        node - a member

   @{b}RESULT@{ub}
        member - the next one, or NULL at the end

   @{b}SEE ALSO@{ub}
        JsonFirst](#jsonfirst)
@endnode

@node JsonNumText "json.library/JsonNumText"
@toc reference
@next JsonParent
@prev JsonNext

@{b}json.library/JsonNumText@{ub}

   @{b}NAME@{ub}
        JsonNumText -- A number's text (0.1).

   @{b}SYNOPSIS@{ub}
        text = JsonNumText(node)
        D0                 A0

        CONST_STRPTR JsonNumText(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns a number exactly as it was written ("8.25", "1e-3"), for a
        program with its own floating-point maths.

   @{b}INPUTS@{ub}
        node - a number

   @{b}RESULT@{ub}
        text - the text (read-only), or NULL for anything else

   @{b}SEE ALSO@{ub}
        JsonInt](#jsonint), @{"JsonScaled" link "JsonScaled"}
@endnode

@node JsonParent "json.library/JsonParent"
@toc reference
@next JsonParse
@prev JsonNumText

@{b}json.library/JsonParent@{ub}

   @{b}NAME@{ub}
        JsonParent -- The object or array a node is in (0.1).

   @{b}SYNOPSIS@{ub}
        parent = JsonParent(node)
        D0                  A0

        JsonNode *JsonParent(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns the object or array that holds node.

   @{b}INPUTS@{ub}
        node - any node

   @{b}RESULT@{ub}
        parent - the object or array, or NULL (the top, or not in a tree)

   @{b}SEE ALSO@{ub}
        JsonFirst](#jsonfirst)
@endnode

@node JsonParse "json.library/JsonParse"
@toc reference
@next JsonRemove
@prev JsonParent

@{b}json.library/JsonParse@{ub}

   @{b}NAME@{ub}
        JsonParse -- Read JSON text (0.1).

   @{b}SYNOPSIS@{ub}
        doc = JsonParse(text, len, flags, err)
        D0             A0    D0   D1     A1

        JsonDoc *JsonParse(CONST_STRPTR, LONG, ULONG, struct JsonError *);

   @{b}FUNCTION@{ub}
        Reads JSON text into a new document. Without flags the text must
        be strict JSON (RFC 8259); a UTF-8 byte order mark at the start is
        allowed.

   @{b}INPUTS@{ub}
        text  - the JSON text
        len   - its length, or -1 for up to its 0
        flags - 0, or any of:
                  JPF_COMMENTS  // and slash-star comments
                  JPF_TRAILING  a comma before ] or }
                  JPF_LATIN1    bytes that are not UTF-8 are Latin-1
                  JPF_RELAXED   all three
        err   - filled in when it fails; may be NULL

   @{b}RESULT@{ub}
        doc - the document, or NULL. err then says where and why:
              Message (English), Line and Col (from 1), Pos (from 0)

        @{b}Notes:@{ub} The text is copied: it may be freed straight after.

   @{b}SEE ALSO@{ub}
        JsonLoad](#jsonload), @{"JsonRoot" link "JsonRoot"}, @{"JsonFree" link "JsonFree"}
@endnode

@node JsonRemove "json.library/JsonRemove"
@toc reference
@next JsonRoot
@prev JsonParse

@{b}json.library/JsonRemove@{ub}

   @{b}NAME@{ub}
        JsonRemove -- Take a node out (0.1).

   @{b}SYNOPSIS@{ub}
        JsonRemove(node)
                   A0

        VOID JsonRemove(JsonNode *);

   @{b}FUNCTION@{ub}
        Takes node out of its object or array (or off the top of its
        document). It stays in the document and can be added again
        elsewhere; its memory goes with @{"JsonFree()" link "JsonFree"}.

   @{b}INPUTS@{ub}
        node - any node; NULL is safe

   @{b}SEE ALSO@{ub}
        JsonAdd](#jsonadd)
@endnode

@node JsonRoot "json.library/JsonRoot"
@toc reference
@next JsonScaled
@prev JsonRemove

@{b}json.library/JsonRoot@{ub}

   @{b}NAME@{ub}
        JsonRoot -- A document's top value (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonRoot(doc)
        D0              A0

        JsonNode *JsonRoot(JsonDoc *);

   @{b}FUNCTION@{ub}
        Returns the value at the top of the document.

   @{b}INPUTS@{ub}
        doc - the document

   @{b}RESULT@{ub}
        node - the top value, or NULL (none yet)

   @{b}SEE ALSO@{ub}
        JsonSetRoot](#jsonsetroot)
@endnode

@node JsonScaled "json.library/JsonScaled"
@toc reference
@next JsonSetRoot
@prev JsonRoot

@{b}json.library/JsonScaled@{ub}

   @{b}NAME@{ub}
        JsonScaled -- A number as fixed point (0.1).

   @{b}SYNOPSIS@{ub}
        value = JsonScaled(node, places, def)
        D0                 A0    D0      D1

        LONG JsonScaled(JsonNode *, LONG, LONG);

   @{b}FUNCTION@{ub}
        Returns the number times 10 to the power places, rounded to the
        nearest whole number (halves away from zero) and kept within a
        LONG: 8.25 with 2 places is 825, with 1 place 83. A string that is
        exactly a JSON number counts as that number.

   @{b}INPUTS@{ub}
        node   - a number
        places - 0 to 9
        def    - what to return for anything else (or places out of range)

   @{b}RESULT@{ub}
        value - the scaled number, or def

   @{b}SEE ALSO@{ub}
        JsonInt](#jsonint), @{"JsonNumText" link "JsonNumText"}
@endnode

@node JsonSetRoot "json.library/JsonSetRoot"
@toc reference
@next JsonString
@prev JsonScaled

@{b}json.library/JsonSetRoot@{ub}

   @{b}NAME@{ub}
        JsonSetRoot -- Set a document's top value (0.1).

   @{b}SYNOPSIS@{ub}
        JsonSetRoot(doc, node)
                    A0   A1

        VOID JsonSetRoot(JsonDoc *, JsonNode *);

   @{b}FUNCTION@{ub}
        Makes node the document's top value. The old one (if any) stays in
        the document, out of the tree.

   @{b}INPUTS@{ub}
        doc  - the document
        node - a node of doc that is in no object or array; NULL empties it

   @{b}SEE ALSO@{ub}
        JsonRoot](#jsonroot), @{"JsonNewDoc" link "JsonNewDoc"}
@endnode

@node JsonString "json.library/JsonString"
@toc reference
@next JsonType
@prev JsonSetRoot

@{b}json.library/JsonString@{ub}

   @{b}NAME@{ub}
        JsonString -- A string's text (0.1).

   @{b}SYNOPSIS@{ub}
        text = JsonString(node)
        D0                A0

        CONST_STRPTR JsonString(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns a string's text, UTF-8, ended with a 0 (read-only, valid
        while the document is).

   @{b}INPUTS@{ub}
        node - a string

   @{b}RESULT@{ub}
        text - the text, or NULL for anything else

        @{b}Notes:@{ub} For Amiga text use @{"JsonLatin1()" link "JsonLatin1"}.

   @{b}SEE ALSO@{ub}
        JsonLatin1](#jsonlatin1), @{"JsonLength" link "JsonLength"}
@endnode

@node JsonType "json.library/JsonType"
@toc reference
@next JsonWrite
@prev JsonString

@{b}json.library/JsonType@{ub}

   @{b}NAME@{ub}
        JsonType -- What a node is (0.1).

   @{b}SYNOPSIS@{ub}
        type = JsonType(node)
        D0              A0

        LONG JsonType(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns the node's type.

   @{b}INPUTS@{ub}
        node - any node, or NULL

   @{b}RESULT@{ub}
        type - JT_OBJECT, JT_ARRAY, JT_STRING, JT_NUMBER, JT_BOOL, JT_NULL,
               or JT_NONE for NULL
@endnode

@node JsonWrite "json.library/JsonWrite"
@toc reference
@next JsonWriteFH
@prev JsonType

@{b}json.library/JsonWrite@{ub}

   @{b}NAME@{ub}
        JsonWrite -- A node as JSON text (0.1).

   @{b}SYNOPSIS@{ub}
        length = JsonWrite(node, buf, size, flags)
        D0                 A0    A1   D0    D1

        LONG JsonWrite(JsonNode *, STRPTR, LONG, ULONG);

   @{b}FUNCTION@{ub}
        Writes node (and everything in it) as JSON text into buf, as
        snprintf does: at most size - 1 bytes and a 0.

   @{b}INPUTS@{ub}
        node  - any node
        buf   - where to write; NULL only measures
        size  - buf's size
        flags - 0, or any of:
                  JWF_PRETTY  one value a line, indented by two spaces
                  JWF_ASCII   every character beyond ASCII as \\uXXXX

   @{b}RESULT@{ub}
        length - the whole text's length, even if buf was too small

        @{b}Notes:@{ub} JsonWrite(n, NULL, 0, flags) + 1 is the buffer size needed.

   @{b}SEE ALSO@{ub}
        JsonWriteFH](#jsonwritefh)
@endnode

@node JsonWriteFH "json.library/JsonWriteFH"
@toc reference
@next ref-the-arexx-entry
@prev JsonWrite

@{b}json.library/JsonWriteFH@{ub}

   @{b}NAME@{ub}
        JsonWriteFH -- A node as JSON text, into a file (0.1).

   @{b}SYNOPSIS@{ub}
        ok = JsonWriteFH(node, fh, flags)
        D0              A0    D1  D0

        LONG JsonWriteFH(JsonNode *, BPTR, ULONG);

   @{b}FUNCTION@{ub}
        Writes node as JSON text to an open file, ended with a newline.

   @{b}INPUTS@{ub}
        node  - any node
        fh    - a file opened for writing (or Output())
        flags - as @{"JsonWrite()" link "JsonWrite"}

   @{b}RESULT@{ub}
        ok - TRUE, or FALSE if writing failed

   @{b}SEE ALSO@{ub}
        JsonWrite](#jsonwrite), @{"JsonLoad" link "JsonLoad"}
@endnode

@node ref-the-arexx-entry "json.library/The ARexx entry"
@toc reference
@prev JsonWriteFH

@{b}json.library/The ARexx entry@{ub}

   @{b}NAME@{ub}
        The ARexx entry -- The library's first entry (offset -30, before
            JsonParse) is not a C call: it is the function ARexx calls for
            ADDLIB('json.library', 0, -30, 0), with a RexxMsg in A0. It
            returns an error code in D0 and the result string in A0 (and
            A1). Do not call it from C. The ARexx functions are in the
            guide.
@endnode

