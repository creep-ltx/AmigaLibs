@node JsonAdd "json.library/JsonAdd"
@toc reference
@next JsonAt

@{b}json.library/JsonAdd@{ub}

   @{b}NAME@{ub}
        JsonAdd -- Put a node into an object or array (0.1).

   @{b}SYNOPSIS@{ub}
        ok = JsonAdd(parent, name, node)
        D0          A0      A1    A2

        LONG JsonAdd(JsonNode *, CONST_STRPTR, JsonNode *);

   @{b}FUNCTION@{ub}
        Adds node as the last member of parent. In an object it needs a
        name (UTF-8; a byte that is not UTF-8 is taken as Latin-1); a
        member of that name already there is replaced. In an array the
        name is ignored (pass NULL).

   @{b}INPUTS@{ub}
        parent - an object or array
        name   - the member's name (objects), or NULL
        node   - from JsonNew...(), or taken out with @{"JsonRemove()" link "JsonRemove"}

   @{b}RESULT@{ub}
        ok - TRUE, or FALSE: node NULL, already in a tree, from another
             document, parent not an object or array (or no name for an
             object), or node is parent or holds it

        @{b}Notes:@{ub} Since a failed JsonNew...() is NULL and JsonAdd() refuses
        NULL, JsonAdd(o, "x", JsonNewInt(doc, 5)) needs no checks.

   @{b}SEE ALSO@{ub}
        JsonRemove](#jsonremove), @{"JsonSetRoot" link "JsonSetRoot"}
@endnode

@node JsonAt "json.library/JsonAt"
@toc reference
@next JsonBool
@prev JsonAdd

@{b}json.library/JsonAt@{ub}

   @{b}NAME@{ub}
        JsonAt -- An array's item by number (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonAt(array, index)
        D0            A0     D0

        JsonNode *JsonAt(JsonNode *, LONG);

   @{b}FUNCTION@{ub}
        Returns the item at index, counting from 0; a negative index
        counts from the end (-1 is the last).

   @{b}INPUTS@{ub}
        array - an array
        index - which item

   @{b}RESULT@{ub}
        node - the item, or NULL (not an array, or no such item)

        @{b}Notes:@{ub} It walks from the start: in a loop over a big array use
        @{"JsonFirst()" link "JsonFirst"} and @{"JsonNext()" link "JsonNext"}.

   @{b}SEE ALSO@{ub}
        JsonFirst](#jsonfirst), @{"JsonFind" link "JsonFind"}
@endnode

@node JsonBool "json.library/JsonBool"
@toc reference
@next JsonCount
@prev JsonAt

@{b}json.library/JsonBool@{ub}

   @{b}NAME@{ub}
        JsonBool -- true or false (0.1).

   @{b}SYNOPSIS@{ub}
        value = JsonBool(node, def)
        D0               A0    D0

        LONG JsonBool(JsonNode *, LONG);

   @{b}FUNCTION@{ub}
        Returns 1 for true and 0 for false.

   @{b}INPUTS@{ub}
        node - a bool
        def  - what to return for anything else

   @{b}RESULT@{ub}
        value - 1, 0, or def

   @{b}SEE ALSO@{ub}
        JsonNewBool](#jsonnewbool)
@endnode

@node JsonCount "json.library/JsonCount"
@toc reference
@next JsonFind
@prev JsonBool

@{b}json.library/JsonCount@{ub}

   @{b}NAME@{ub}
        JsonCount -- How many members (0.1).

   @{b}SYNOPSIS@{ub}
        count = JsonCount(node)
        D0                A0

        LONG JsonCount(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns how many members an object or array has.

   @{b}INPUTS@{ub}
        node - an object or array

   @{b}RESULT@{ub}
        count - the members; 0 for anything else

   @{b}SEE ALSO@{ub}
        JsonFirst](#jsonfirst)
@endnode

@node JsonFind "json.library/JsonFind"
@toc reference
@next JsonFirst
@prev JsonCount

@{b}json.library/JsonFind@{ub}

   @{b}NAME@{ub}
        JsonFind -- A node by path (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonFind(start, path)
        D0              A0     A1

        JsonNode *JsonFind(JsonNode *, CONST_STRPTR);

   @{b}FUNCTION@{ub}
        Follows a path from start: names joined by dots, [n] for an
        array's n-th item (from 0, negative from the end), ["name"] for a
        name with dots or brackets (\\" and \\\\ inside). An empty path is
        start itself.

   @{b}INPUTS@{ub}
        start - where the path begins (usually JsonRoot(doc))
        path  - like "weather.days[0].temp" (UTF-8)

   @{b}RESULT@{ub}
        node - what the path leads to, or NULL

   @{b}SEE ALSO@{ub}
        JsonGet](#jsonget), @{"JsonAt" link "JsonAt"}
@endnode

@node JsonFirst "json.library/JsonFirst"
@toc reference
@next JsonFree
@prev JsonFind

@{b}json.library/JsonFirst@{ub}

   @{b}NAME@{ub}
        JsonFirst -- The first member (0.1).

   @{b}SYNOPSIS@{ub}
        member = JsonFirst(node)
        D0                A0

        JsonNode *JsonFirst(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns the first member of an object or array; @{"JsonNext()" link "JsonNext"} gives
        the rest.

   @{b}INPUTS@{ub}
        node - an object or array

   @{b}RESULT@{ub}
        member - the first member, or NULL (empty, or not an object or array)

        @{b}Notes:@{ub} for (m = JsonFirst(o); m; m = JsonNext(m)) ...

   @{b}SEE ALSO@{ub}
        JsonNext](#jsonnext), @{"JsonName" link "JsonName"}
@endnode

@node JsonFree "json.library/JsonFree"
@toc reference
@next JsonGet
@prev JsonFirst

@{b}json.library/JsonFree@{ub}

   @{b}NAME@{ub}
        JsonFree -- Free a document (0.1).

   @{b}SYNOPSIS@{ub}
        JsonFree(doc)
                 A0

        VOID JsonFree(JsonDoc *);

   @{b}FUNCTION@{ub}
        Frees the document and every node and string in it. Nothing from
        it may be used afterwards.

   @{b}INPUTS@{ub}
        doc - from @{"JsonParse()" link "JsonParse"}, @{"JsonLoad()" link "JsonLoad"} or @{"JsonNewDoc()" link "JsonNewDoc"}; NULL is safe

   @{b}SEE ALSO@{ub}
        JsonParse](#jsonparse), @{"JsonNewDoc" link "JsonNewDoc"}
@endnode

@node JsonGet "json.library/JsonGet"
@toc reference
@next JsonInt
@prev JsonFree

@{b}json.library/JsonGet@{ub}

   @{b}NAME@{ub}
        JsonGet -- An object's member by name (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonGet(object, name)
        D0             A0      A1

        JsonNode *JsonGet(JsonNode *, CONST_STRPTR);

   @{b}FUNCTION@{ub}
        Returns the member called name. If the name is there more than
        once, the last one (as JavaScript does).

   @{b}INPUTS@{ub}
        object - an object
        name   - the name, UTF-8

   @{b}RESULT@{ub}
        node - the member, or NULL

   @{b}SEE ALSO@{ub}
        JsonFind](#jsonfind), @{"JsonAt" link "JsonAt"}
@endnode

@node JsonInt "json.library/JsonInt"
@toc reference
@next JsonLatin1
@prev JsonGet

@{b}json.library/JsonInt@{ub}

   @{b}NAME@{ub}
        JsonInt -- A number as a whole number (0.1).

   @{b}SYNOPSIS@{ub}
        value = JsonInt(node, def)
        D0              A0    D0

        LONG JsonInt(JsonNode *, LONG);

   @{b}FUNCTION@{ub}
        Returns the number rounded to the nearest whole number (halves
        away from zero: 8.5 is 9, -8.5 is -9), kept between -2147483648
        and 2147483647. A string that is exactly a JSON number ("8.5")
        counts as that number.

   @{b}INPUTS@{ub}
        node - a number
        def  - what to return for anything else

   @{b}RESULT@{ub}
        value - the number, or def

   @{b}SEE ALSO@{ub}
        JsonScaled](#jsonscaled), @{"JsonNumText" link "JsonNumText"}
@endnode

@node JsonLatin1 "json.library/JsonLatin1"
@toc reference
@next JsonLength
@prev JsonInt

@{b}json.library/JsonLatin1@{ub}

   @{b}NAME@{ub}
        JsonLatin1 -- A string as Amiga text (0.1).

   @{b}SYNOPSIS@{ub}
        length = JsonLatin1(node, buf, size)
        D0                  A0    A1   D0

        LONG JsonLatin1(JsonNode *, STRPTR, LONG);

   @{b}FUNCTION@{ub}
        Copies a string (or a number's text) into buf as Latin-1, ended
        with a 0. Characters Latin-1 does not have become the nearest it
        has (L as L, EUR as E, curly quotes as ", dashes as -), else ?.

   @{b}INPUTS@{ub}
        node - a string or number
        buf  - where to put it; NULL only measures
        size - buf's size, the 0 included

   @{b}RESULT@{ub}
        length - the whole text's length, even if buf was too small;
                 -1 if node is not a string or number (buf gets "")

        @{b}Notes:@{ub} JsonLatin1(n, NULL, 0) + 1 is the buffer size needed.

   @{b}SEE ALSO@{ub}
        JsonString](#jsonstring), @{"JsonNewString" link "JsonNewString"}
@endnode

@node JsonLength "json.library/JsonLength"
@toc reference
@next JsonLoad
@prev JsonLatin1

@{b}json.library/JsonLength@{ub}

   @{b}NAME@{ub}
        JsonLength -- A string's length (0.1).

   @{b}SYNOPSIS@{ub}
        length = JsonLength(node)
        D0                  A0

        LONG JsonLength(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns the length in bytes (UTF-8) of a string, or of a number's
        text.

   @{b}INPUTS@{ub}
        node - a string or number

   @{b}RESULT@{ub}
        length - the bytes, or 0 for anything else

        @{b}Notes:@{ub} A string can hold a 0 byte (\\u0000 in the JSON):
        @{"JsonString()" link "JsonString"} stops there, JsonLength() does not.

   @{b}SEE ALSO@{ub}
        JsonString](#jsonstring)
@endnode

@node JsonLoad "json.library/JsonLoad"
@toc reference
@next JsonName
@prev JsonLength

@{b}json.library/JsonLoad@{ub}

   @{b}NAME@{ub}
        JsonLoad -- Read a JSON file (0.1).

   @{b}SYNOPSIS@{ub}
        doc = JsonLoad(name, flags, err)
        D0            A0    D0     A1

        JsonDoc *JsonLoad(CONST_STRPTR, ULONG, struct JsonError *);

   @{b}FUNCTION@{ub}
        Reads a whole file (or pipe) and reads it as @{"JsonParse()" link "JsonParse"} does.

   @{b}INPUTS@{ub}
        name  - the file
        flags - as @{"JsonParse()" link "JsonParse"}
        err   - filled in when it fails; may be NULL

   @{b}RESULT@{ub}
        doc - the document, or NULL (Message: "cannot open the file",
              "cannot read the file", "out of memory", or what was
              wrong with the JSON)

   @{b}SEE ALSO@{ub}
        JsonParse](#jsonparse), @{"JsonWriteFH" link "JsonWriteFH"}
@endnode

@node JsonName "json.library/JsonName"
@toc reference
@next JsonNewArray
@prev JsonLoad

@{b}json.library/JsonName@{ub}

   @{b}NAME@{ub}
        JsonName -- A member's name (0.1).

   @{b}SYNOPSIS@{ub}
        name = JsonName(node)
        D0              A0

        CONST_STRPTR JsonName(JsonNode *);

   @{b}FUNCTION@{ub}
        Returns the name of an object's member (UTF-8, read-only, valid
        while the document is).

   @{b}INPUTS@{ub}
        node - a member of an object

   @{b}RESULT@{ub}
        name - the name, or NULL (not in an object)

