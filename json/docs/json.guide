@toc reference
@next JsonNewDoc
@prev JsonNewArray

@{b}json.library/JsonNewBool@{ub}

   @{b}NAME@{ub}
        JsonNewBool -- A new true or false (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonNewBool(doc, value)
        D0                 A0   D0

        JsonNode *JsonNewBool(JsonDoc *, LONG);

   @{b}FUNCTION@{ub}
        Makes true (value not 0) or false.

   @{b}INPUTS@{ub}
        doc   - the document
        value - TRUE or FALSE

   @{b}RESULT@{ub}
        node - the bool, or NULL

   @{b}SEE ALSO@{ub}
        JsonAdd](#jsonadd)
@endnode

@node JsonNewDoc "json.library/JsonNewDoc"
@toc reference
@next JsonNewInt
@prev JsonNewBool

@{b}json.library/JsonNewDoc@{ub}

   @{b}NAME@{ub}
        JsonNewDoc -- A new, empty document (0.1).

   @{b}SYNOPSIS@{ub}
        doc = JsonNewDoc()
        D0

        JsonDoc *JsonNewDoc(void);

   @{b}FUNCTION@{ub}
        Makes an empty document to build in. Give it a top value with
        @{"JsonSetRoot()" link "JsonSetRoot"}.

   @{b}RESULT@{ub}
        doc - the document, or NULL (out of memory)

   @{b}SEE ALSO@{ub}
        JsonSetRoot](#jsonsetroot), @{"JsonFree" link "JsonFree"}
@endnode

@node JsonNewInt "json.library/JsonNewInt"
@toc reference
@next JsonNewNull
@prev JsonNewDoc

@{b}json.library/JsonNewInt@{ub}

   @{b}NAME@{ub}
        JsonNewInt -- A new number from a LONG (0.1).

   @{b}SYNOPSIS@{ub}
        node = JsonNewInt(doc, value)
        D0                A0   D0

        JsonNode *JsonNewInt(JsonDoc *, LONG);

   @{b}FUNCTION@{ub}
        Makes a whole number.

   @{b}INPUTS@{ub}
        doc   - the document
        value - the number

   @{b}RESULT@{ub}
        node - the number, or NULL

