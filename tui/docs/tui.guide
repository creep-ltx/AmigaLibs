@node TuiBeep "tui.library/TuiBeep"
@toc reference
@next TuiBox

@{b}tui.library/TuiBeep@{ub}

   @{b}NAME@{ub}
        TuiBeep -- Ring the terminal's bell (0.1).

   @{b}SYNOPSIS@{ub}
        TuiBeep(t)
                A0

        VOID TuiBeep(struct Tui *);

   @{b}FUNCTION@{ub}
        Sends the bell character at once (no flush needed). What it does
        is the terminal's choice: a flash, a sound, or nothing.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}
@endnode

@node TuiBox "tui.library/TuiBox"
@toc reference
@next TuiCharWidth
@prev TuiBeep

@{b}tui.library/TuiBox@{ub}

   @{b}NAME@{ub}
        TuiBox -- The character for a part of a box (0.1).

   @{b}SYNOPSIS@{ub}
        c = TuiBox(t, which)
        D0         A0 D0

        ULONG TuiBox(struct Tui *, LONG);

   @{b}FUNCTION@{ub}
        Returns the character to draw a box part with: a Unicode line in
        CTerm, ASCII in a plain console. Draws nothing itself: pass the
        result to @{"TuiPutC()" link "TuiPutC"} or @{"TuiFill()" link "TuiFill"}.

   @{b}INPUTS@{ub}
        t     - from @{"TuiOpen()" link "TuiOpen"}; NULL gives the ASCII set
        which - BX_H, BX_V (lines), BX_TL, BX_TR, BX_BL, BX_BR (corners),
                BX_ARROW, BX_DOT

   @{b}RESULT@{ub}
        c - the character; '?' for an unknown which

   @{b}EXAMPLE@{ub}
        TuiFill(t, 1, 0, w - 2, TuiBox(t, BX_H), 7, TC_DEFAULT, 0);
@endnode

@node TuiCharWidth "tui.library/TuiCharWidth"
@toc reference
@next TuiClear
@prev TuiBox

@{b}tui.library/TuiCharWidth@{ub}

   @{b}NAME@{ub}
        TuiCharWidth -- How many cells a character takes (0.5).

   @{b}SYNOPSIS@{ub}
        cells = TuiCharWidth(c)
        D0                   D0

        LONG TuiCharWidth(ULONG);

   @{b}FUNCTION@{ub}
        Says how many cells of the grid a character takes, the same answer
        @{"TuiPutC()" link "TuiPutC"} and @{"TuiPutUTF8()" link "TuiPutUTF8"} use: lay text out with it and wide
        characters line up.

   @{b}INPUTS@{ub}
        c - a Unicode character (Latin-1 is the same below 256)

   @{b}RESULT@{ub}
        cells - 2: wide (Chinese, Japanese, Korean, most emoji)
                1: the rest
                0: a mark that joins the character before (an accent)
               -1: a control (0-31, 127-159) or not a character

        @{b}Notes:@{ub} The widths are utf8.library's (Unicode 16) when it is in
        LIBS:, else the library's own table, the same as CTerm's. Check
        lib_Revision >= 5 before calling it; the tui_charwidth() glue name
        does that and answers 1 for an older library.
@endnode

@node TuiClear "tui.library/TuiClear"
@toc reference
@next TuiClose
@prev TuiCharWidth

@{b}tui.library/TuiClear@{ub}

   @{b}NAME@{ub}
        TuiClear -- Empty the whole grid (0.1).

   @{b}SYNOPSIS@{ub}
        TuiClear(t)
                 A0

        VOID TuiClear(struct Tui *);

   @{b}FUNCTION@{ub}
        Fills every cell with a space, colour 7 on TC_DEFAULT, no
        attributes. Like every drawing call it shows on the next flush,
        and only the cells that were not empty already are sent.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}

        @{b}Notes:@{ub} Clearing and drawing everything again for each change is
        the intended way to use the library: @{"TuiFlush()" link "TuiFlush"} sends only the
        difference.
@endnode

@node TuiClose "tui.library/TuiClose"
@toc reference
@next TuiCursor
@prev TuiClear

@{b}tui.library/TuiClose@{ub}

   @{b}NAME@{ub}
        TuiClose -- Give the terminal back (0.1).

   @{b}SYNOPSIS@{ub}
        TuiClose(t)
                 A0

        VOID TuiClose(struct Tui *);

   @{b}FUNCTION@{ub}
        Leaves raw mode, switches the cursor, line wrapping and (in CTerm)
        the Shell's own screen back on, and frees t. A plain console has
        no second screen: it is cleared.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}; NULL is safe

        @{b}Notes:@{ub} Call it on every way out of the program, errors included,
        or the Shell is left in raw mode with no cursor. t may not be used
        again.

   @{b}SEE ALSO@{ub}
        TuiOpen()](#tuiopen), @{"TuiSuspend()" link "TuiSuspend"}
@endnode

@node TuiCursor "tui.library/TuiCursor"
@toc reference
@next TuiDirty
@prev TuiClose

@{b}tui.library/TuiCursor@{ub}

   @{b}NAME@{ub}
        TuiCursor -- Where the text cursor shows (0.1).

   @{b}SYNOPSIS@{ub}
        TuiCursor(t, col, row, on)
                  A0 D0   D1   D2

        VOID TuiCursor(struct Tui *, LONG, LONG, LONG);

   @{b}FUNCTION@{ub}
        Sets where the cursor is shown after the next @{"TuiFlush()" link "TuiFlush"}, or hides
        it. While the library draws, the cursor is always hidden, so it
        never jumps about.

   @{b}INPUTS@{ub}
        t        - from @{"TuiOpen()" link "TuiOpen"}
        col, row - the cell, from 0
        on       - TRUE to show it there, FALSE to hide it (the default)
@endnode

@node TuiDirty "tui.library/TuiDirty"
@toc reference
@next TuiFill
@prev TuiCursor

@{b}tui.library/TuiDirty@{ub}

   @{b}NAME@{ub}
        TuiDirty -- Cells the terminal may show otherwise now (0.1).

   @{b}SYNOPSIS@{ub}
        TuiDirty(t, col, row, w, h)
                 A0 D0   D1   D2 D3

        VOID TuiDirty(struct Tui *, LONG, LONG, LONG, LONG);

   @{b}FUNCTION@{ub}
        Marks a rectangle of cells as unknown, so the next @{"TuiFlush()" link "TuiFlush"}
        sends them again whatever they hold. Used to take away a picture
        sent with @{"TuiRaw()" link "TuiRaw"}.

   @{b}INPUTS@{ub}
        t        - from @{"TuiOpen()" link "TuiOpen"}
        col, row - the top-left cell
        w, h     - the size in cells; the part outside the grid is ignored

   @{b}SEE ALSO@{ub}
        TuiRaw()](#tuiraw), @{"TuiRedraw()" link "TuiRedraw"}
@endnode

@node TuiFill "tui.library/TuiFill"
@toc reference
@next TuiFlush
@prev TuiDirty

@{b}tui.library/TuiFill@{ub}

   @{b}NAME@{ub}
        TuiFill -- A row of one character (0.1).

   @{b}SYNOPSIS@{ub}
        TuiFill(t, col, row, w, c, fg, bg, attr)
                A0 D0   D1   D2 D3 D4  D5  D6

        VOID TuiFill(struct Tui *, LONG, LONG, LONG, ULONG, LONG, LONG, LONG);

   @{b}FUNCTION@{ub}
        Puts w copies of c from col along row: lines, bars, empty space.

   @{b}INPUTS@{ub}
        t        - from @{"TuiOpen()" link "TuiOpen"}
        col, row - the first cell; what falls outside the grid is cut off
        w        - how many cells
        c        - the character, Latin-1 or Unicode (see @{"TuiPutC()" link "TuiPutC"})
        fg, bg   - colours: 0-15, TC_DEFAULT, TC_X(n), TC_RGB(r,g,b),
                   TC_PEN(n)
        attr     - TA_BOLD, TA_UNDER, TA_REV, TA_ITAL, TA_DIM, TA_STRIKE
                   or'ed together, or 0

        @{b}Notes:@{ub} A full block in a plain console becomes a reversed space:
        attr's TA_REV is flipped for it.
@endnode

@node TuiFlush "tui.library/TuiFlush"
@toc reference
@next TuiKeyAfter
@prev TuiFill

@{b}tui.library/TuiFlush@{ub}

   @{b}NAME@{ub}
        TuiFlush -- Show what was drawn (0.1).

   @{b}SYNOPSIS@{ub}
        TuiFlush(t)
                 A0

        VOID TuiFlush(struct Tui *);

   @{b}FUNCTION@{ub}
        Compares the grid the program drew with what the terminal shows
        and sends only the cells that differ, then places or hides the
        cursor (@{"TuiCursor()" link "TuiCursor"}). Does nothing while suspended.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}

        @{b}Notes:@{ub} @{"TuiWait()" link "TuiWait"} flushes by itself before it waits. A program with
        its own Wait() (@{"TuiSignal()" link "TuiSignal"}) must flush before it. The
        bottom-right cell of a plain console is never written: the console
        would scroll.
@endnode

@node TuiKeyAfter "tui.library/TuiKeyAfter"
@toc reference
@next TuiKeyWaiting
@prev TuiFlush

@{b}tui.library/TuiKeyAfter@{ub}

   @{b}NAME@{ub}
        TuiKeyAfter -- Wait for a key after a command's output (0.1).

   @{b}SYNOPSIS@{ub}
        TuiKeyAfter(t, msg)
                    A0 A1

        VOID TuiKeyAfter(struct Tui *, CONST_STRPTR);

   @{b}FUNCTION@{ub}
        While suspended: shows msg in reverse under the command's output
        and waits for one key, so the user can read the output before
        @{"TuiResume()" link "TuiResume"} draws the program again.

   @{b}INPUTS@{ub}
        t   - from @{"TuiOpen()" link "TuiOpen"}, suspended
        msg - the text, Latin-1; NULL gives " a key goes back "

        @{b}Notes:@{ub} If the terminal goes while waiting, the next @{"TuiWait()" link "TuiWait"}
        returns TE_END.

   @{b}SEE ALSO@{ub}
        TuiSuspend()](#tuisuspend), @{"TuiResume()" link "TuiResume"}
@endnode

@node TuiKeyWaiting "tui.library/TuiKeyWaiting"
@toc reference
@next TuiOpen
@prev TuiKeyAfter

@{b}tui.library/TuiKeyWaiting@{ub}

   @{b}NAME@{ub}
        TuiKeyWaiting -- Is an event waiting? (0.3).

   @{b}SYNOPSIS@{ub}
        waiting = TuiKeyWaiting(t)
        D0                      A0

        LONG TuiKeyWaiting(struct Tui *);

   @{b}FUNCTION@{ub}
        Says whether a key, click, paste or the end of the terminal is
        waiting, without taking it or waiting. For a long job that should
        stop when the user presses a key.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}

   @{b}RESULT@{ub}
        waiting - TRUE if something is waiting (take it with @{"TuiPoll()" link "TuiPoll"}
                  or @{"TuiWait()" link "TuiWait"}); also TRUE if the terminal has gone

   @{b}SEE ALSO@{ub}
        @{"TuiPoll()" link "TuiPoll"}](#tuipoll)
@endnode

@node TuiOpen "tui.library/TuiOpen"
@toc reference
@next TuiOpenIO
@prev TuiKeyWaiting

@{b}tui.library/TuiOpen@{ub}

   @{b}NAME@{ub}
        TuiOpen -- Take over the terminal (0.1).

   @{b}SYNOPSIS@{ub}
        t = TuiOpen(in)
        D0          D1

        struct Tui *TuiOpen(BPTR);

   @{b}FUNCTION@{ub}
        Sets the console to raw mode, switches off wrapping, takes CTerm's
        second screen, mouse, pastes and UTF-8 where it has them, asks the
        terminal's size and makes a grid that size, empty.

        The public fields of struct Tui (read them, never write them):

            Cols, Rows   the size now
            CTerm        TRUE in CTerm
            UTF8         TRUE if the terminal takes UTF-8
            CellW, CellH a cell in pixels (CTerm), else 0

   @{b}INPUTS@{ub}
        in - the console to read keys from; 0 for the program's Input().
             A program whose Input() is a pipe opens "*" itself and passes
             that.

   @{b}RESULT@{ub}
        t - the terminal, for every other call; NULL if in or Output() is
            not an interactive console (started from Workbench, output to
            a file, NIL:) or memory ran out

        @{b}Notes:@{ub} t belongs to the calling task: use it only from there.

   @{b}SEE ALSO@{ub}
        TuiPossible()](#tuipossible), @{"TuiClose()" link "TuiClose"}
@endnode

@node TuiOpenIO "tui.library/TuiOpenIO"
@toc reference
@next TuiPoll
@prev TuiOpen

@{b}tui.library/TuiOpenIO@{ub}

   @{b}NAME@{ub}
        TuiOpenIO -- Take over the terminal, keys and screen on given
            handles (0.4).

   @{b}SYNOPSIS@{ub}
        t = TuiOpenIO(in, out)
        D0            D1  D2

        struct Tui *TuiOpenIO(BPTR, BPTR);

   @{b}FUNCTION@{ub}
        As @{"TuiOpen()" link "TuiOpen"}, but the screen is drawn on out instead of Output().
        For a program whose output is captured (in backquotes, or
        redirected to a file) that still draws in the console: open the
        console as "*" and pass it for in and/or out.

   @{b}INPUTS@{ub}
        in  - the console to read keys from; 0 for Input()
        out - the console to draw on; 0 for Output()

   @{b}RESULT@{ub}
        t - the terminal, or NULL if in or out is not an interactive console

        @{b}Notes:@{ub} Check lib_Revision >= 4 before calling it. TuiOpen(in) is
        TuiOpenIO(in, 0).

   @{b}SEE ALSO@{ub}
        TuiOpen](#tuiopen), @{"TuiClose" link "TuiClose"}
@endnode

@node TuiPoll "tui.library/TuiPoll"
@toc reference
@next TuiPossible
@prev TuiOpenIO

@{b}tui.library/TuiPoll@{ub}

   @{b}NAME@{ub}
        TuiPoll -- The next event, without waiting (0.3).

   @{b}SYNOPSIS@{ub}
        got = TuiPoll(t, e)
        D0            A0 A1

        LONG TuiPoll(struct Tui *, TuiEv *);

   @{b}FUNCTION@{ub}
        For a program with its own Wait(): after the @{"TuiSignal()" link "TuiSignal"} signal
        came (or at any time), takes the next event if there is one. Call
        it until it returns 0.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}
        e - filled in (see @{"TuiWait()" link "TuiWait"} for the event types)

   @{b}RESULT@{ub}
        got - 1 with an event in e, 0 with e->type TE_NONE

        @{b}Notes:@{ub} Unlike @{"TuiWait()" link "TuiWait"}, Ctrl-C to F are left as the program's own
        signals; they are not turned into keys.

   @{b}SEE ALSO@{ub}
        TuiSignal()](#tuisignal), @{"TuiWait()" link "TuiWait"}
@endnode

@node TuiPossible "tui.library/TuiPossible"
@toc reference
@next TuiPut
@prev TuiPoll

@{b}tui.library/TuiPossible@{ub}

   @{b}NAME@{ub}
        TuiPossible -- Could @{"TuiOpen()" link "TuiOpen"} work here? (0.1).

   @{b}SYNOPSIS@{ub}
        ok = TuiPossible(in)
        D0               D1

        LONG TuiPossible(BPTR);

   @{b}FUNCTION@{ub}
        Says whether in (0: Input()) and Output() are both an interactive
        console, without changing anything. For a program that falls back
        to plain output when it is not in a terminal.

   @{b}INPUTS@{ub}
        in - as for @{"TuiOpen()" link "TuiOpen"}

   @{b}RESULT@{ub}
        ok - TRUE if @{"TuiOpen()" link "TuiOpen"} can work
@endnode

@node TuiPut "tui.library/TuiPut"
@toc reference
@next TuiPutC
@prev TuiPossible

@{b}tui.library/TuiPut@{ub}

   @{b}NAME@{ub}
        TuiPut -- Latin-1 text (0.1).

   @{b}SYNOPSIS@{ub}
        TuiPut(t, col, row, s, len, fg, bg, attr)
               A0 D0   D1   A1 D2   D3  D4  D5

        VOID TuiPut(struct Tui *, LONG, LONG, CONST_STRPTR, LONG, LONG, LONG,
                    LONG);

   @{b}FUNCTION@{ub}
        Puts len bytes of Latin-1 text from col along row, one cell a
        byte. The fastest way to draw text.

   @{b}INPUTS@{ub}
        t        - from @{"TuiOpen()" link "TuiOpen"}
        col, row - the first cell; what falls outside the grid is cut off,
                   also when col is negative
        s        - the text
        len      - its length in bytes: must be given, 0 or more
        fg, bg   - colours, see @{"TuiFill()" link "TuiFill"}
        attr     - attributes, see @{"TuiFill()" link "TuiFill"}

        @{b}Notes:@{ub} Control characters show as '?'. For UTF-8 text use
        @{"TuiPutUTF8()" link "TuiPutUTF8"}.
@endnode

@node TuiPutC "tui.library/TuiPutC"
@toc reference
@next TuiPutUTF8
@prev TuiPut

@{b}tui.library/TuiPutC@{ub}

   @{b}NAME@{ub}
        TuiPutC -- One character (0.1).

   @{b}SYNOPSIS@{ub}
        TuiPutC(t, col, row, c, fg, bg, attr)
                A0 D0   D1   D2 D3  D4  D5

        VOID TuiPutC(struct Tui *, LONG, LONG, ULONG, LONG, LONG, LONG);

   @{b}FUNCTION@{ub}
        Puts one character in one cell, or a wide one in two (0.5).

   @{b}INPUTS@{ub}
        t        - from @{"TuiOpen()" link "TuiOpen"}
        col, row - the cell; outside the grid nothing happens
        c        - Latin-1 (0-255) or Unicode (up to 0x10FFFF). A plain
                   console gets the nearest it has (box lines as - | +,
                   accented letters without the accent, ...). A wide
                   character (@{"TuiCharWidth()" link "TuiCharWidth"} 2) takes this cell and the next:
                   in a plain console '?' and a space; in the last column '?'.
                   A combining mark alone shows as '?'.
        fg, bg   - colours, see @{"TuiFill()" link "TuiFill"}
        attr     - attributes, see @{"TuiFill()" link "TuiFill"}
@endnode

@node TuiPutUTF8 "tui.library/TuiPutUTF8"
@toc reference
@next TuiRaw
@prev TuiPutC

@{b}tui.library/TuiPutUTF8@{ub}

   @{b}NAME@{ub}
        TuiPutUTF8 -- UTF-8 text (0.2).

   @{b}SYNOPSIS@{ub}
        cells = TuiPutUTF8(t, col, row, s, len, fg, bg, attr)
        D0                 A0 D0   D1   A1 D2   D3  D4  D5

        LONG TuiPutUTF8(struct Tui *, LONG, LONG, CONST_STRPTR, LONG, LONG,
                        LONG, LONG);

   @{b}FUNCTION@{ub}
        Puts UTF-8 text from col along row: one cell a character, two for
        a wide one (0.5), and accents written as separate marks put on
        their letter (with utf8.library; without it they are left out). A
        byte that is not valid UTF-8 is taken as Latin-1, so Latin-1 text
        still shows right.

   @{b}INPUTS@{ub}
        t        - from @{"TuiOpen()" link "TuiOpen"}; NULL only counts the cells
        col, row - the first cell; what falls outside the grid is cut off
        s        - the text
        len      - its length in bytes, or -1 for up to its 0
        fg, bg   - colours, see @{"TuiFill()" link "TuiFill"}
        attr     - attributes, see @{"TuiFill()" link "TuiFill"}

   @{b}RESULT@{ub}
        cells - how many cells the text takes, counting those cut off:
                the next text can follow at col + cells

        @{b}Notes:@{ub} Check lib_Revision >= 2 before calling it.
@endnode

@node TuiRaw "tui.library/TuiRaw"
@toc reference
@next TuiRedraw
@prev TuiPutUTF8

@{b}tui.library/TuiRaw@{ub}

   @{b}NAME@{ub}
        TuiRaw -- Bytes straight to the terminal (0.1).

   @{b}SYNOPSIS@{ub}
        TuiRaw(t, col, row, s, n)
               A0 D0   D1   A1 D2

        VOID TuiRaw(struct Tui *, LONG, LONG, CONST_STRPTR, LONG);

   @{b}FUNCTION@{ub}
        Moves to the cell and writes n bytes as they are, at once: a
        picture (sixel, kitty, iTerm) or another sequence the library does
        not know. Afterwards the library forgets where the cursor is and
        which colours are set.

   @{b}INPUTS@{ub}
        t        - from @{"TuiOpen()" link "TuiOpen"}
        col, row - where the bytes start
        s, n     - the bytes and their count

        @{b}Notes:@{ub} Flush first. The cells under a picture are still the
        library's: draw nothing there while it shows, and @{"TuiDirty()" link "TuiDirty"} them
        to take it away. Send pictures only to terminals that take them.

   @{b}SEE ALSO@{ub}
        @{"TuiDirty()" link "TuiDirty"}](#tuidirty)
@endnode

@node TuiRedraw "tui.library/TuiRedraw"
@toc reference
@next TuiResized
@prev TuiRaw

@{b}tui.library/TuiRedraw@{ub}

   @{b}NAME@{ub}
        TuiRedraw -- Send every cell on the next flush (0.1).

   @{b}SYNOPSIS@{ub}
        TuiRedraw(t)
                  A0

        VOID TuiRedraw(struct Tui *);

   @{b}FUNCTION@{ub}
        Clears the terminal and forgets what it shows, so the next
        @{"TuiFlush()" link "TuiFlush"} sends the whole grid. For when something else wrote to
        the terminal, or the user asks for a redraw (Ctrl-L).

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}
@endnode

@node TuiResized "tui.library/TuiResized"
@toc reference
@next TuiResume
@prev TuiRedraw

@{b}tui.library/TuiResized@{ub}

   @{b}NAME@{ub}
        TuiResized -- Make the grid the terminal's new size (0.1).

   @{b}SYNOPSIS@{ub}
        changed = TuiResized(t)
        D0                   A0

        LONG TuiResized(struct Tui *);

   @{b}FUNCTION@{ub}
        After a TE_RESIZE event: makes the grid Cols x Rows, empty, and
        sends everything on the next flush. The program then draws
        everything again.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}

   @{b}RESULT@{ub}
        changed - TRUE if the size really changed

        @{b}Notes:@{ub} The size is kept between 10 x 3 and 400 x 200.
@endnode

@node TuiResume "tui.library/TuiResume"
@toc reference
@next TuiSignal
@prev TuiResized

@{b}tui.library/TuiResume@{ub}

   @{b}NAME@{ub}
        TuiResume -- Take the terminal again after @{"TuiSuspend()" link "TuiSuspend"} (0.1).

   @{b}SYNOPSIS@{ub}
        TuiResume(t)
                  A0

        VOID TuiResume(struct Tui *);

   @{b}FUNCTION@{ub}
        Raw mode and the other settings again, asks the size (it may have
        changed meanwhile) and sends every cell on the next flush.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}, suspended

        @{b}Notes:@{ub} The program should draw everything again: Cols and Rows may
        differ.
@endnode

@node TuiSignal "tui.library/TuiSignal"
@toc reference
@next TuiSuspend
@prev TuiResume

@{b}tui.library/TuiSignal@{ub}

   @{b}NAME@{ub}
        TuiSignal -- The signal to add to the program's own Wait() (0.3).

   @{b}SYNOPSIS@{ub}
        sigmask = TuiSignal(t)
        D0                  A0

        ULONG TuiSignal(struct Tui *);

   @{b}FUNCTION@{ub}
        For a program that waits for more than the terminal (a window,
        ARexx, a socket). Sends the request for keys to the console if it
        is not out already, and returns the signal mask to add to Wait().
        When it comes, take the events with @{"TuiPoll()" link "TuiPoll"}.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}

   @{b}RESULT@{ub}
        sigmask - the signal, as a mask

   @{b}EXAMPLE@{ub}
        TuiFlush(t);
        sig = Wait(TuiSignal(t) | arexxsig | SIGBREAKF_CTRL_C);
        ...
        while (TuiPoll(t, &e)) handle(&e);

        @{b}Notes:@{ub} Call it before every Wait(), not once. The signal comes
        within a quarter of a second even with no key pressed; then
        @{"TuiPoll()" link "TuiPoll"} just returns 0.

   @{b}SEE ALSO@{ub}
        TuiPoll()](#tuipoll), @{"TuiKeyWaiting()" link "TuiKeyWaiting"}
@endnode

@node TuiSuspend "tui.library/TuiSuspend"
@toc reference
@next TuiTitle
@prev TuiSignal

@{b}tui.library/TuiSuspend@{ub}

   @{b}NAME@{ub}
        TuiSuspend -- Lend the terminal to a command (0.1).

   @{b}SYNOPSIS@{ub}
        TuiSuspend(t)
                   A0

        VOID TuiSuspend(struct Tui *);

   @{b}FUNCTION@{ub}
        Puts the terminal back as the Shell had it (as @{"TuiClose()" link "TuiClose"} does)
        but keeps t, so a command can run in it. Drawing calls still fill
        the grid; nothing is sent until @{"TuiResume()" link "TuiResume"}.

   @{b}INPUTS@{ub}
        t - from @{"TuiOpen()" link "TuiOpen"}

   @{b}SEE ALSO@{ub}
        TuiKeyAfter()](#tuikeyafter), @{"TuiResume()" link "TuiResume"}
@endnode

@node TuiTitle "tui.library/TuiTitle"
@toc reference
@next TuiWait
@prev TuiSuspend

@{b}tui.library/TuiTitle@{ub}

   @{b}NAME@{ub}
        TuiTitle -- The tab's title (0.1).

   @{b}SYNOPSIS@{ub}
        TuiTitle(t, title)
                 A0 A1

        VOID TuiTitle(struct Tui *, CONST_STRPTR);

   @{b}FUNCTION@{ub}
        Sets the title of the CTerm tab the program runs in. Does nothing
        in a plain console. The title is taken away again by @{"TuiClose()" link "TuiClose"}
        and @{"TuiSuspend()" link "TuiSuspend"} and put back by @{"TuiResume()" link "TuiResume"} (0.4), so the tab
        does not go on showing it.

   @{b}INPUTS@{ub}
        t     - from @{"TuiOpen()" link "TuiOpen"}
        title - the text, 0-terminated
@endnode

@node TuiWait "tui.library/TuiWait"
@toc reference
@prev TuiTitle

@{b}tui.library/TuiWait@{ub}

   @{b}NAME@{ub}
        TuiWait -- Wait for the next event (0.1).

   @{b}SYNOPSIS@{ub}
        got = TuiWait(t, e, us, extra, sigs)
        D0            A0 A1 D0  D1     A2

        LONG TuiWait(struct Tui *, TuiEv *, LONG, ULONG, ULONG *);

   @{b}FUNCTION@{ub}
        Flushes the screen, then waits until an event comes, the time runs
        out or one of the extra signals comes. Ctrl-C to F are taken and
        given as keys (TM_CTRL | 'c' ...), so quitting always works.

        Events (e->type):

            TE_KEY     e->key: the character (Latin-1 / Unicode), or K_UP,
                       K_DOWN, K_LEFT, K_RIGHT, K_HOME, K_END, K_PGUP,
                       K_PGDN, K_INS, K_DEL, K_BS, K_TAB, K_ENTER, K_ESC,
                       K_HELP, K_F(1)..K_F(12); with TM_SHIFT, TM_ALT,
                       TM_CTRL or'ed in (K_BASE() takes them off)
            TE_MOUSE   (CTerm) e->mact: TB_PRESS, TB_RELEASE, TB_DRAG,
                       TB_WHEELUP, TB_WHEELDOWN; e->col, e->row: the cell;
                       e->mods: TM_*; e->secs, e->mics: when
            TE_PASTE   (CTerm) e->text, e->len: the pasted text, valid
                       until the next event
            TE_RESIZE  Cols and Rows hold the new size: call @{"TuiResized()" link "TuiResized"}
                       and draw everything again
            TE_END     the terminal has gone: quit. Every later call
                       returns TE_END too.

   @{b}INPUTS@{ub}
        t     - from @{"TuiOpen()" link "TuiOpen"}
        e     - filled in
        us    - the longest wait in microseconds; -1 for ever, 0 not at
                all
        extra - more signals to wake for, or 0
        sigs  - set to which of extra came; may be NULL

   @{b}RESULT@{ub}
        got - 1 with an event in e; 0 when the time ran out or an extra
              signal came (e->type is TE_NONE)

        @{b}Notes:@{ub} The library keeps up to 64 events waiting.

   @{b}SEE ALSO@{ub}
        TuiPoll()](#tuipoll), @{"TuiSignal()" link "TuiSignal"}
@endnode

